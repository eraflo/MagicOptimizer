# --- Rust ---
target/
**/*.rs.bk
*.pdb

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Tauri ---
src-tauri/target/
# `gen/*` rather than `gen/`: git does not look inside an ignored directory, so a blanket
# ignore here would make the exception below impossible to express.
src-tauri/gen/*

# The Android project is generated by `cargo tauri android init`, but it is then edited by
# hand — the CAMERA permission lives in its manifest and nowhere else. Once it exists it has to
# be committed, or that edit is lost on the next clone. Only its build output stays ignored.
!src-tauri/gen/android/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/local.properties
src-tauri/gen/android/.idea/

# --- Generated data artifacts ---
# NEVER committed: produced by tools/build-artifacts, published as GitHub Releases.
# See docs/dev/data-pipeline.md
artifacts/
*.rkyv
arthashes.bin
embeddings.bin

# --- Downloaded raw data ---
# Scryfall bulk, card images, API snapshots. Large and not ours to redistribute.
.cache/
data/raw/
data/images/
*.jsonl
*.jsonl.gz

# --- Local user database ---
*.redb
*.redb.lock

# --- Misc ---
.DS_Store
Thumbs.db
.env
.env.local
*.log
